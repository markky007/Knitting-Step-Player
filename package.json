  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@playwright/test": "^1.51.0",
    "@quasar/app-vite": "^3.10.1",
    "@types/node": "^22.19.11",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
